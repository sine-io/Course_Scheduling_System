# 复制为 .env 后，至少修改管理员密码与学校名称即可启动。
#   cp .env.example .env

# ── 必改 ─────────────────────────────
# 系统管理员默认账号和密码（首次登录后必须修改密码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
# 学校名称（显示在界面和导出课表中）
SCHOOL_NAME=示范学校
# 系统固定使用 Asia/Shanghai，无需配置时区。
# 会话 Cookie 签名密钥（正式部署务必改为随机长字符串，例如 openssl rand -hex 32 的输出）
SECRET_KEY=please-change-this-to-a-random-secret

# ── 网络 ─────────────────────────────
# 对外端口(默认 80;若被占用可改 8080 等)
HTTP_PORT=80

# ── 选配:域名与 HTTPS(校外连接时使用,见 docs/deploy/https.md)──
# 使用内网 IP 时保留默认值(不设置 SITE_ADDRESS,使用 HTTP)即可。
# 若有公开域名并要自动申请 HTTPS 证书，请填写域名（需先将域名 A 记录指向本主机）：
# SITE_ADDRESS=school.example.edu.cn
# HTTPS_PORT=443
# 设了上面的域名(走 HTTPS)后,系统会自动为登录 cookie 加上 Secure 标记;
# 一般不必手动设置。若需强制指定可用下行(true=仅 HTTPS 传送 cookie):
# COOKIE_SECURE=true

# ── 预建镜像版本(仅「拉取镜像」部署方式需要)──────────
# 使用 sudo docker compose pull 拉取官方镜像时，决定拉取哪个版本。
# 默认 latest(最新);正式部署建议固定版本号以利可控升级,例如:
# IMAGE_TAG=v1.0.0
# 如果通过源代码执行 sudo docker compose up -d 自行构建，可忽略此项。
IMAGE_TAG=latest

# ── 数据库(单机部署保留默认值即可;若修改账号和密码需三者一致)──
POSTGRES_USER=scheduler
POSTGRES_PASSWORD=scheduler
POSTGRES_DB=scheduler
DATABASE_URL=postgresql+psycopg://scheduler:scheduler@postgres:5432/scheduler

# ── 队列 ─────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── 选填:互动式 API 文件 ──────────────
# 默认关闭。端点本身均受权限保护,公开它不是漏洞,但会把整套内部 API 摊在网络上;
# 若要自行对接系统 API,可暂时打开 http://<主机>/api/docs 查阅后再关掉。
# API_DOCS_ENABLED=true

# ── 选填:发送邮件(未设置则仅站内通知,见 M4-3)──
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
