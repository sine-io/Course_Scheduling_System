# 正式部署反向代理设置。
# 站点地址由环境变量 SITE_ADDRESS 决定(于 .env 设置,由 web 容器带入):
#   未设置(默认):`:80` — 内网 IP 走 HTTP。
#   设为域名（如 school.example.edu.cn）：Caddy 自动申请并续期 HTTPS 证书。
{
	admin off
}

{$SITE_ADDRESS::80} {
	# 请求体上限,防止(内部误操作或被盗账号的)超大上传打爆单校主机内存。
	# 200MB 容得下真实数据库恢复的 .dump 与 Excel 导入;超大数据库恢复改用 volume 复制法
	# (见 docs/deploy/backup.md),不走网页上传。
	request_body {
		max_size 200MB
	}

	# API 交给后端
	handle /api/* {
		reverse_proxy api:8000
	}

	# 其余走前端 SPA,找不到文件回退 index.html(支持 vue-router history 模式)
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	encode gzip
}
