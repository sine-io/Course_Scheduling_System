# 正式部署的 web 容器：第一阶段用 Node 构建 Vue 前端，
# 第二阶段用 Caddy 服务静态文件并反向代理 /api 至后端。
# 静态资源与 CPU 架构无关，使用 BUILDPLATFORM 避免多架构构建时运行模拟器。
FROM --platform=$BUILDPLATFORM node:22-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM caddy:2-alpine
COPY Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv
# Only the user-facing manual and its deployment pages ship with the web
# image; architecture, agent, ADR, and requirements documents stay private.
COPY docs/index.html /srv/docs/index.html
COPY docs/deploy/*.html /srv/docs/deploy/
COPY docs/manual-img/*.png /srv/docs/manual-img/
